parameters:
	ignoreErrors:
		-
			message: '#^Anonymous function should return Pest\\Mixins\\Expectation\<bool\|null\> but returns Pest\\Mixins\\Expectation\<bool\|null\>\.$#'
			identifier: return.type
			count: 1
			path: tests/Feature/Filament/ConcerningTasksTest.php

		-
			message: '#^Access to an undefined property Illuminate\\Contracts\\Queue\\Job\:\:\$failedWith\.$#'
			identifier: property.notFound
			count: 1
			path: tests/Feature/Jobs/SyncJiraIssuesJobTest.php

		-
			message: '#^Function jiraIssuePayload\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: tests/Feature/Jobs/SyncJiraIssuesJobTest.php

		-
			message: '#^Function syncUser\(\) has parameter \$attributes with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: tests/Feature/Jobs/SyncJiraIssuesJobTest.php

		-
			message: '#^Function mentionsUser\(\) has parameter \$attributes with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: tests/Feature/Jobs/SyncJiraMentionsJobTest.php

		-
			message: '#^Function fullJiraPayload\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: tests/Unit/Services/JiraIssueMapperTest.php

		-
			message: '#^Parameter \#1 \$json of function json_decode expects string, int\|string\|null given\.$#'
			identifier: argument.type
			count: 1
			path: tests/Unit/Services/JiraIssueMapperTest.php
